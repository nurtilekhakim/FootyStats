
<%- include('partials/header', { title: 'Search Results' }) %>

<main class="container search-results-page">

    <div class="results-header">

        <div class="search-badge">
            ⚡ FOOTBALL DATABASE
        </div>

        <h1>
            Search <span class="accent">Results.</span>
        </h1>

        <p>
            Showing results for
            <span class="results-query">
                "<%= searchQuery %>"
            </span>
        </p>

        <a href="/#explore" class="results-back">
            ← Back to Explore
        </a>

    </div>

    <% if (teams && teams.length > 0) { %>

        <div class="results-count">
            <%= teams.length %>
            <%= teams.length === 1 ? 'club found' : 'clubs found' %>
        </div>

        <div class="results-team-grid">

            <% teams.forEach(team => { %>

                <article class="results-team-card">

                    <div class="results-card-top">
                        <span class="results-club-label">
                            FOOTBALL CLUB
                        </span>

                        <% if (team.strBadge) { %>
                            <img
                                src="<%= team.strBadge %>"
                                alt="<%= team.strTeam %> badge"
                                class="results-team-logo"
                                loading="lazy"
                            >
                        <% } else { %>
                            <div class="results-logo-placeholder">
                                ⚽
                            </div>
                        <% } %>
                    </div>

                    <div class="results-card-info">

                        <h2><%= team.strTeam %></h2>

                        <p class="results-country">
                            <span>📍</span>
                            <%= team.strCountry || 'Unknown country' %>
                        </p>

                        <% if (team.strLeague) { %>
                            <p class="results-league">
                                🏆 <%= team.strLeague %>
                            </p>
                        <% } %>

                    </div>

                    <a
                        href="/team/<%= team.idTeam %>"
                        class="results-view-btn"
                    >
                        View Club
                        <span aria-hidden="true">→</span>
                    </a>

                </article>

            <% }) %>

        </div>

    <% } else { %>

        <div class="results-empty">
            <div class="results-empty-icon">⚽</div>

            <h2>No teams found</h2>

            <p>
                We couldn't find a football club matching
                "<%= searchQuery %>".
                Try searching with another name.
            </p>

            <a href="/#explore" class="results-view-btn">
                Try Another Search →
            </a>
        </div>

    <% } %>

</main>

<%- include('partials/footer') %>
