
<%- include('partials/header', { title: 'Home' }) %>

<main class="container home-v2">

    <!-- HERO SECTION -->
    <section class="home-hero">

        <div class="home-hero-content">

            <div class="home-eyebrow">
                <span class="home-live-dot"></span>
                YOUR FOOTBALL WORLD
            </div>

            <h1>
                THE GAME.
                <br>
                <span class="accent">THE DATA.</span>
                <br>
                YOUR WAY.
            </h1>

            <p>
                Explore the world's football clubs,
                discover players, and follow recent
                match results. All in one place.
            </p>

            <div class="home-hero-actions">
                <a href="#leagues" class="home-primary-btn">
                    Explore Football
                    <span>↗</span>
                </a>

                <a href="#team-search" class="home-secondary-btn">
                    Search a Club →
                </a>
            </div>

            <div class="home-stats">
                <div>
                    <strong>03</strong>
                    <span>Featured Leagues</span>
                </div>

                <div>
                    <strong>05</strong>
                    <span>API Operations</span>
                </div>

                <div>
                    <strong>24/7</strong>
                    <span>Online Access</span>
                </div>
            </div>
        </div>

        <div class="home-hero-visual">
            <div class="home-visual-glow"></div>

            <div class="home-football-art">
                ⚽
            </div>

            <div class="home-floating-card home-float-top">
                <span>⚡ EXPLORE</span>
                <strong>FOOTBALL DATA</strong>
            </div>

            <div class="home-floating-card home-float-bottom">
                <span>GLOBAL CLUB DATABASE</span>
                <strong>Discover More ↗</strong>
            </div>
        </div>

    </section>

    <!-- LEAGUES -->
    <section class="home-leagues" id="leagues">

        <div class="home-section-heading">
            <div>
                <span class="home-section-label">
                    DISCOVER FOOTBALL
                </span>

                <h2>
                    Explore <span class="accent">Leagues.</span>
                </h2>
            </div>

            <p>
                Choose your favorite competition
                and discover its football clubs.
            </p>
        </div>

        <div class="home-league-grid">

            <!-- PREMIER LEAGUE -->
            <form action="/teams" method="GET"
                  class="home-league-card">

                <input type="hidden" name="league"
                       value="English Premier League">

                <div class="home-league-top">
                    <span class="home-league-symbol">
                        <img
                            src="https://flagcdn.com/gb-eng.svg"
                            alt="England flag"
                            loading="lazy"
                        >
                    </span>
                    <span class="home-league-arrow">↗</span>
                </div>

                <span class="home-league-country">
                    ENGLAND
                </span>

                <h3>Premier League</h3>

                <p>Explore English football clubs.</p>

                <button type="submit">
                    Explore League →
                </button>
            </form>

            <!-- LA LIGA -->
            <form action="/teams" method="GET"
                  class="home-league-card">

                <input type="hidden" name="league"
                       value="Spanish La Liga">

                <div class="home-league-top">
                    <span class="home-league-symbol">
                        <img
                            src="https://flagcdn.com/es.svg"
                            alt="Spain flag"
                            loading="lazy"
                        >
                    </span>
                    <span class="home-league-arrow">↗</span>
                </div>

                <span class="home-league-country">
                    SPAIN
                </span>

                <h3>La Liga</h3>

                <p>Discover Spanish football clubs.</p>

                <button type="submit">
                    Explore League →
                </button>
            </form>

            <!-- BUNDESLIGA -->
            <form action="/teams" method="GET"
                  class="home-league-card">

                <input type="hidden" name="league"
                       value="German Bundesliga">

                <div class="home-league-top">
                    <span class="home-league-symbol">
                        <img
                            src="https://flagcdn.com/de.svg"
                            alt="Germany flag"
                            loading="lazy"
                        >
                    </span>
                    <span class="home-league-arrow">↗</span>
                </div>

                <span class="home-league-country">
                    GERMANY
                </span>

                <h3>Bundesliga</h3>

                <p>Explore German football clubs.</p>

                <button type="submit">
                    Explore League →
                </button>
            </form>

        </div>
    </section>

    <!-- SEARCH -->
    <section class="search-section" id="team-search">

        <div class="search-glow"></div>

        <div class="search-content">

            <div class="search-badge">
                ⚡ FOOTBALL DATABASE
            </div>

            <h2>
                Find Your <span class="accent">Team.</span>
            </h2>

            <p>
                Search football clubs from around the world.
                Your next discovery starts here.
            </p>

            <form action="/search" method="POST"
                  class="modern-search-form">

                <div class="modern-search-input">
                    <span class="search-icon"
                          aria-hidden="true">⌕</span>

                    <input
                        type="text"
                        name="teamName"
                        placeholder="Try Arsenal, Barcelona, Real Madrid..."
                        minlength="2"
                        maxlength="100"
                        aria-label="Football team name"
                        required
                    >
                </div>

                <button type="submit"
                        class="modern-search-btn">
                    Search Team
                    <span aria-hidden="true">→</span>
                </button>
            </form>

            <div class="search-hint">
                <span class="hint-dot"></span>
                Explore clubs worldwide
            </div>
        </div>
    </section>

</main>

<%- include('partials/footer') %>
