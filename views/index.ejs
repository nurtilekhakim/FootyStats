
<%- include('partials/header', { title: 'Home' }) %>

<main class="container">

    <section class="hero">
        <h1>
            Explore the World of
            <span class="accent">Football</span>
        </h1>

        <p>
            Discover football clubs, explore players,
            and follow match results — all in one place.
        </p>

        <div class="search-box" id="explore">
            <h2>Find Your Favourite Team</h2>

            <form action="/teams" method="GET">
                <label for="league">
                    Select Football League
                </label>

                <select id="league" name="league" required>
                    <option value="English Premier League">
                        English Premier League
                    </option>

                    <option value="Spanish La Liga">
                        Spanish La Liga
                    </option>

                    <option value="German Bundesliga">
                        German Bundesliga
                    </option>
                </select>

                <button class="btn" type="submit">
                    Explore Teams →
                </button>
            </form>
        </div>
    </section>

    <!-- Modern Team Search -->
    <section class="search-section">

        <div class="search-glow"></div>

        <div class="search-content">

            <div class="search-badge">
                ⚡ FOOTBALL DATABASE
            </div>

            <h2>
                Find Your
                <span class="accent">Team.</span>
            </h2>

            <p>
                Search football clubs from around the world.
                Your next discovery starts here.
            </p>

            <form
                action="/search"
                method="POST"
                class="modern-search-form"
            >

                <div class="modern-search-input">

                    <span class="search-icon"
                          aria-hidden="true">
                        ⌕
                    </span>

                    <input
                        type="text"
                        name="teamName"
                        placeholder="Try Arsenal, Barcelona, Real Madrid..."
                        minlength="2"
                        maxlength="100"
                        aria-label="Football team name"
                        required
                    >

                </div>

                <button
                    type="submit"
                    class="modern-search-btn"
                >
                    Search Team
                    <span aria-hidden="true">→</span>
                </button>

            </form>

            <div class="search-hint">
                <span class="hint-dot"></span>
                Explore clubs worldwide
            </div>

        </div>

    </section>

</main>

<%- include('partials/footer') %>
