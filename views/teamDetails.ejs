
<%- include('partials/header', { title: team.strTeam }) %>

<%
    const countryFlags = {
        England: 'gb-eng',
        Spain: 'es',
        Germany: 'de'
    };

    const flagCode = countryFlags[team.strCountry];
%>

<main class="container club-page">

    <a href="/" class="club-back-link">
        ← Back to Home
    </a>

    <!-- CLUB HERO -->
    <section class="club-hero">

        <div class="club-hero-glow"></div>

        <div class="club-hero-content">

            <div class="club-logo-box">
                <% if (team.strBadge) { %>
                    <img
                        src="<%= team.strBadge %>"
                        alt="<%= team.strTeam %> logo"
                        class="club-logo"
                    >
                <% } else { %>
                    <span class="club-logo-fallback">⚽</span>
                <% } %>
            </div>

            <div class="club-hero-info">

                <span class="club-label">
                    ⚡ FOOTBALL CLUB PROFILE
                </span>

                <h1><%= team.strTeam %></h1>

                <p class="club-subtitle">
                    <%= team.strLeague || 'Football Club' %>
                </p>

                <div class="club-tags">

                    <span>
                        📍 <%= team.strCountry || 'Unknown country' %>
                    </span>

                    <% if (team.intFormedYear) { %>
                        <span>
                            🏆 Founded <%= team.intFormedYear %>
                        </span>
                    <% } %>

                </div>

            </div>
        </div>

        <div class="club-hero-actions">

            <a
                href="/team/<%= team.idTeam %>/players"
                class="club-primary-btn"
            >
                View Players
                <span aria-hidden="true">→</span>
            </a>

            <a
                href="/team/<%= team.idTeam %>/matches"
                class="club-secondary-btn"
            >
                Recent Matches
                <span aria-hidden="true">↗</span>
            </a>

        </div>

    </section>

    <!-- CLUB INFORMATION -->
    <section class="club-details-section">

        <div class="club-section-heading">
            <span class="home-section-label">
                CLUB OVERVIEW
            </span>

            <h2>
                Club <span class="accent">Information.</span>
            </h2>
        </div>

        <div class="club-info-grid">

            <!-- COUNTRY -->
            <div class="club-info-card">

                <span class="club-info-icon">

                    <% if (flagCode) { %>
                        <img
                            src="https://flagcdn.com/<%= flagCode %>.svg"
                            alt="<%= team.strCountry %> flag"
                            class="club-country-flag"
                        >
                    <% } else { %>
                        🌍
                    <% } %>

                </span>

                <span class="club-info-label">
                    COUNTRY
                </span>

                <h3>
                    <%= team.strCountry || 'Unknown' %>
                </h3>
            </div>

            <!-- LEAGUE -->
            <div class="club-info-card">

                <span class="club-info-icon">🏆</span>

                <span class="club-info-label">
                    LEAGUE
                </span>

                <h3>
                    <%= team.strLeague || 'Unknown' %>
                </h3>
            </div>

            <!-- STADIUM -->
            <div class="club-info-card">

                <span class="club-info-icon">🏟️</span>

                <span class="club-info-label">
                    STADIUM
                </span>

                <h3>
                    <%= team.strStadium || 'Unknown' %>
                </h3>
            </div>

            <!-- FOUNDED -->
            <div class="club-info-card">

                <span class="club-info-icon">📅</span>

                <span class="club-info-label">
                    FOUNDED
                </span>

                <h3>
                    <%= team.intFormedYear || 'Unknown' %>
                </h3>
            </div>

        </div>

    </section>

    <!-- ABOUT THE CLUB -->
    <section class="club-about">

        <div class="club-about-heading">
            <span class="home-section-label">
                THE STORY
            </span>

            <h2>
                About <span class="accent">the Club.</span>
            </h2>
        </div>

        <div class="club-about-card">

            <p>
                <%= team.strDescriptionEN ||
                    'No description available for this club.' %>
            </p>

        </div>

    </section>

    <!-- EXPLORE MORE -->
    <section class="club-explore">

        <h2>
            Explore <span class="accent">More.</span>
        </h2>

        <div class="club-explore-grid">

            <a
                href="/team/<%= team.idTeam %>/players"
                class="club-explore-card"
            >
                <span class="club-explore-icon">👥</span>

                <h3>Team Players</h3>

                <p>
                    Discover the players representing
                    this football club.
                </p>

                <span class="club-explore-arrow">
                    Explore Players →
                </span>
            </a>

            <a
                href="/team/<%= team.idTeam %>/matches"
                class="club-explore-card"
            >
                <span class="club-explore-icon">⚽</span>

                <h3>Recent Matches</h3>

                <p>
                    Check recent match results
                    and football scores.
                </p>

                <span class="club-explore-arrow">
                    View Matches →
                </span>
            </a>

        </div>

    </section>

</main>

<%- include('partials/footer') %>
